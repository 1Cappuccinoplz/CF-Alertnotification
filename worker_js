export default {
  async fetch(request, env) {
    if (request.method !== "POST") {
      return new Response("Method Not Allowed", { status: 405 });
    }

    // Optional: Authenticate using a shared secret header
    if (env.WEBHOOK_SECRET) {
      const secret = request.headers.get("cf-webhook-auth");
      if (secret !== env.WEBHOOK_SECRET) {
        return new Response("Unauthorized", { status: 401 });
      }
    }

    try {
      const data = await request.json();

      // Cloudflare Health Check alerts include name, status, and description
      const alertName = data.name || "Cloudflare Alert";
      const alertText = data.text || JSON.stringify(data, null, 2);

      const telegramPayload = {
        chat_id: env.TELEGRAM_CHAT_ID,
        parse_mode: "Markdown",
        text: `🚨 *Cloudflare Notification*\n\n*Alert:* ${alertName}\n*Details:* ${alertText}\n*Time:* ${new Date().toUTCString()}`,
      };

      const response = await fetch(`https://api.telegram.org/bot${env.TELEGRAM_BOT_TOKEN}/sendMessage`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(telegramPayload),
      });

      if (!response.ok) {
        const err = await response.text();
        return new Response(`Telegram API Error: ${err}`, { status: 502 });
      }

      return new Response("OK", { status: 200 });
    } catch (err) {
      return new Response(`Worker Error: ${err.message}`, { status: 500 });
    }
  },
};
